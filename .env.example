MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace_with_a_random_64_character_hex_secret
BREVO_API_KEY=
